{
  "name": "Edge-Firewall-Config",
  "default_action": "DENY",
  "rules": [
    {
      "priority": 10,
      "action": "ALLOW",
      "protocol": "TCP",
      "dst_port": 80,
      "description": "Allow HTTP traffic"
    },
    {
      "priority": 20,
      "action": "ALLOW",
      "protocol": "TCP",
      "dst_port": 443,
      "description": "Allow HTTPS traffic"
    },
    {
      "priority": 30,
      "action": "ALLOW",
      "protocol": "ICMP",
      "description": "Allow diagnostic ping"
    }
  ]
}
